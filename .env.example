# chipLLM Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Authentication: Application Default Credentials (ADC) ONLY.
#   DO NOT add GOOGLE_API_KEY or service account JSON paths here.
#
# Local setup (one-time):
#   gcloud auth application-default login
#   gcloud config set project <your-project-id>
#
# Cloud Run: attach a service account with roles/aiplatform.user — no config needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: GCP project and region ────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Optional: model override (default: gemini-2.0-flash-001) ────────────────
CHIPLLM_MODEL=gemini-2.0-flash-001

# ── Streamlit server (Cloud Run sets $PORT automatically) ───────────────────
PORT=8080
