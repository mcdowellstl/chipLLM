# chipLLM Environment Configuration
# Copy this file to .env and fill in your values.
# For local dev with google-genai API key:
#   GOOGLE_API_KEY=your_api_key_here
# For Vertex AI (Cloud Run):
#   GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#   GOOGLE_CLOUD_LOCATION=us-central1   (or your preferred region)

# ── Option A: Local development (Google AI Studio API key) ──────────────────
GOOGLE_API_KEY=

# ── Option B: Vertex AI on Cloud Run (preferred for production) ─────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ── Model selection (defaults to gemini-2.0-flash-001) ─────────────────────
CHIPLLM_MODEL=gemini-2.0-flash-001

# ── Streamlit server settings ────────────────────────────────────────────────
# PORT is automatically set by Cloud Run
PORT=8080
